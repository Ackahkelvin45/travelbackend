# ============================================================
# .env.prod.example — Production environment template
# ============================================================
# Copy this file to .env.prod and fill in real values.
# NEVER commit .env.prod to version control.
# ============================================================

# ── Django ─────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DEBUG=False
DJANGO_ENV=production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS / CSRF — list your frontend origin(s)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Public URL of the Next.js frontend — used in emails (dashboard & claim links)
FRONTEND_URL=https://azuratravels.live

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgres://traveltour_user:STRONG_PASSWORD@db:5432/traveltour
POSTGRES_DB=traveltour
POSTGRES_USER=traveltour_user
POSTGRES_PASSWORD=STRONG_PASSWORD

# ── Paystack ───────────────────────────────────────────────
# Live keys from dashboard.paystack.com → Settings → API Keys.
# Also register the webhook there: https://<backend-domain>/api/payments/webhook/
PAYSTACK_SECRET_KEY=sk_live_your_live_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_live_key_here

# ── Resend (transactional email) ───────────────────────────
# From resend.com → API Keys. Empty = log-only mode (no emails go out!).
RESEND_API_KEY=re_your_live_key_here
RESEND_FROM_EMAIL=Azura Travels <bookings@azuratravels.live>

# ── Payments & FX ──────────────────────────────────────────
# Fallback for critical alerts (gateway mismatches, overpayments, FX feed
# problems). The primary setting lives in Admin → Payments → Operational
# Settings; this env value is used only when that field is empty.
ADMIN_ALERT_EMAIL=joegyem4u@yahoo.com
# NOTE: scheduling (FX refresh, payment reminders) is handled in-app —
# no crontab entries are required.
# Optional FX tuning (sensible defaults apply):
# FX_CACHE_SECONDS=3600
# FX_MAX_STALENESS_HOURS=24
# FX_SANITY_MAX_DEVIATION_PERCENT=20
# PENDING_BOOKING_TTL_HOURS=24
